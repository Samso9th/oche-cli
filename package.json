{
  "name": "oche-cli",
  "version": "0.1.0",
  "description": "Command-line client for Oche: promote dev → staging \u2192 main from your terminal.",
  "type": "module",
  "bin": {
    "oche": "./dist/index.js"
  },
  "files": [
    "dist"
