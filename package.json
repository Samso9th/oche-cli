{
  "name": "oche-cli",
  "version": "0.1.2",
  "description": "Command-line client for Oche: promote dev → staging → main from your terminal.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Samso9th/oche-cli.git"
  },
  "homepage": "https://oche.io",
  "bugs": "https://github.com/Samso9th/oche-cli/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "oche": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "commander": "^15.0.0",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.2"
  }
}
